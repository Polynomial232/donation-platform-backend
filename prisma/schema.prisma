// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DonationStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED

  @@map("donation_status")
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  REFUNDED

  @@map("transaction_status")
}

enum OverlayType {
  ALERT
  GOAL
  EVENT_LIST

  @@map("overlay_type")
}

enum QueueStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@map("queue_status")
}

enum SectionType {
  GOALS
  ACHIEVEMENTS
  PINNED_WIDGET
  RECENT_ACTIVITY
  CUSTOM_CONTENT
  TOP_SUPPORTERS

  @@map("section_type")
}

model User {
  id          String    @id @default(dbgenerated("gen_random_uuid()"))
  email       String    @unique
  username    String    @unique
  password    String
  displayName String?   @map("display_name")
  avatarUrl   String?   @map("avatar_url")
  
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  
  // Relations
  creator     Creator?
  donations   Donation[] @relation("DonorRelation")
  follows     Follow[]
  overlays    Overlay[]

  @@map("users")
}


model Creator {
  id                String    @id @default(dbgenerated("gen_random_uuid()"))
  userId            String    @unique @map("user_id")
  user              User      @relation(fields: [userId], references: [id])
  username          String    @unique
  displayName       String    @map("display_name")
  avatarUrl         String?   @map("avatar_url")
  bannerUrl         String?   @map("banner_url")
  bio               String?
  isVerified        Boolean   @default(false) @map("is_verified")
  isLive            Boolean   @default(false) @map("is_live")
  
  categories        CreatorCategory[]
  followers         Follow[]
  receivedDonations Donation[] @relation("RecipientRelation")
  sections          CreatorSection[]
  achievements      CreatorAchievement[]
  goals             Goal[]
  settings          CreatorSetting?
  soundBoard        SoundBoard[]

  xenditApiKey         String?  @map("xendit_api_key")
  notificationSettings Json?    @map("notification_settings")
  socialLinks          Json?    @map("social_links")
  
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  @@map("creators")
}

model CreatorSection {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  creatorId  String   @map("creator_id")
  creator    Creator  @relation(fields: [creatorId], references: [id])
  type       SectionType
  title      String
  isEnabled  Boolean? @map("is_enabled")
  data       Json
  
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("creator_sections")
}

model Category {
  id         String    @id @default(dbgenerated("gen_random_uuid()"))
  name       String    @unique
  creators   CreatorCategory[]
  
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("categories")
}

model CreatorCategory {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  creatorId  String   @map("creator_id")
  creator    Creator  @relation(fields: [creatorId], references: [id])
  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([creatorId, categoryId])
  @@map("creator_categories")
}

model Follow {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  creatorId  String   @map("creator_id")
  creator    Creator  @relation(fields: [creatorId], references: [id])
  
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, creatorId])
  @@map("follows")
}

model Donation {
  id            String         @id @default(dbgenerated("gen_random_uuid()"))
  externalId    String         @unique @map("external_id")
  amount        Decimal        @db.Decimal(12, 2)
  currency      String         @default("IDR")
  donorName     String         @map("donor_name")
  message       String?
  status        DonationStatus @default(PENDING)
  paymentUrl    String?        @map("payment_url")
  paymentMethod String?        @map("payment_method")
  
  recipientId   String         @map("recipient_id")
  recipient     Creator        @relation("RecipientRelation", fields: [recipientId], references: [id])
  
  donorId       String?        @map("donor_id")
  donor         User?          @relation("DonorRelation", fields: [donorId], references: [id])
  
  mediaType     String?        @map("media_type")
  mediaUrl      String?        @map("media_url")
  
  isPinned      Boolean        @default(false) @map("is_pinned")
  
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")

  transactions  Transaction[]
  
  goalId        String?        @map("goal_id")
  goal          Goal?          @relation(fields: [goalId], references: [id])
  
  @@index([recipientId, isPinned])
  @@map("donations")
}

model Transaction {
  id          String            @id @default(dbgenerated("gen_random_uuid()"))
  donationId  String            @map("donation_id")
  donation    Donation          @relation(fields: [donationId], references: [id])
  amount      Decimal           @db.Decimal(12, 2)
  currency    String            @default("IDR")
  status      TransactionStatus @default(PENDING)
  referenceId String?           @unique @map("reference_id")
  
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  deletedAt   DateTime?         @map("deleted_at")

  @@map("transactions")
}

model Overlay {
  id        String      @id @default(dbgenerated("gen_random_uuid()"))
  userId    String      @map("user_id")
  user      User        @relation(fields: [userId], references: [id])
  type      OverlayType
  name      String
  config    Json
  token     String      @unique
  isActive  Boolean     @default(true) @map("is_active")
  
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  deletedAt DateTime?   @map("deleted_at")

  @@map("overlays")
}

model Goal {
  id            String    @id @default(dbgenerated("gen_random_uuid()"))
  creatorId     String    @map("creator_id")
  creator       Creator   @relation(fields: [creatorId], references: [id])
  title         String
  targetAmount  Decimal   @db.Decimal(12, 2) @map("target_amount")
  currentAmount Decimal   @db.Decimal(12, 2) @default(0) @map("current_amount")
  startDate     DateTime  @default(now()) @map("start_date")
  endDate       DateTime? @map("end_date")
  isActive      Boolean   @default(true) @map("is_active")
  
  donations     Donation[]

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  @@map("goals")
}

model SiteSetting {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  key         String   @unique
  value       Json
  description String?
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model ApiQueue {
  id         String      @id @default(dbgenerated("gen_random_uuid()"))
  url        String
  method     String      @default("POST")
  headers    Json?
  body       Json?
  status     QueueStatus @default(PENDING)
  type       String
  retryCount Int         @default(0) @map("retry_count")
  maxRetries Int         @default(3) @map("max_retries")
  lastError  String?     @map("last_error")
  
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  deletedAt  DateTime?   @map("deleted_at")

  @@map("api_queues")
}

model ApiCallback {
  id         String    @id @default(dbgenerated("gen_random_uuid()"))
  source     String
  eventType  String    @map("event_type")
  payload    Json
  headers    Json?
  statusCode Int?      @map("status_code")
  
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@map("api_callbacks")
}

model Achievement {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  name        String   @unique
  description String?
  imageUrl    String?  // Image URL
  category    String?  // e.g., 'DONATION', 'STREAK', 'MILESTONE'
  
  creators    CreatorAchievement[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("achievements")
}

model CreatorAchievement {
  id            String   @id @default(dbgenerated("gen_random_uuid()"))
  creatorId     String   @map("creator_id")
  creator       Creator  @relation(fields: [creatorId], references: [id])
  achievementId String   @map("achievement_id")
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  
  earnedAt      DateTime @default(now()) @map("earned_at")

  @@unique([creatorId, achievementId])
  @@map("creator_achievements")
}

model CreatorSetting {
  id                    String                @id @default(dbgenerated("gen_random_uuid()"))
  creatorId             String                @unique @map("creator_id")
  creator               Creator               @relation(fields: [creatorId], references: [id])
  
  isMediaShareEnabled   Boolean?              @map("is_media_share_enabled")
  isSoundEnabled        Boolean?              @map("is_sound_enabled")
  minAlertAmount        Decimal?              @db.Decimal(12, 2) @map("min_alert_amount")
  
  quickAmounts          CreatorQuickAmount[]
  paymentMethods        CreatorPaymentMethod[]

  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  @@map("creator_settings")
}

model CreatorQuickAmount {
  id          String         @id @default(dbgenerated("gen_random_uuid()"))
  settingId   String         @map("setting_id")
  setting     CreatorSetting @relation(fields: [settingId], references: [id])
  amount      Int

  @@map("creator_quick_amounts")
}

model PaymentProvider {
  id             String                 @id @default(dbgenerated("gen_random_uuid()"))
  key            String                 @unique // e.g., 'QRIS', 'PAYPAL'
  name           String
  description    String?
  isInternational Boolean               @default(false) @map("is_international")
  
  creatorMethods CreatorPaymentMethod[]

  @@map("payment_providers")
}

model CreatorPaymentMethod {
  id          String          @id @default(dbgenerated("gen_random_uuid()"))
  settingId   String          @map("setting_id")
  setting     CreatorSetting  @relation(fields: [settingId], references: [id])
  providerId  String          @map("provider_id")
  provider    PaymentProvider @relation(fields: [providerId], references: [id])
  isEnabled   Boolean         @default(true) @map("is_enabled")

  @@unique([settingId, providerId])
  @@map("creator_payment_methods")
}


model SoundBoard {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  name      String
  duration  String?  // e.g., '0:02'
  price     Decimal  @db.Decimal(12, 2)
  audioUrl  String   @map("audio_url")
  creatorId String   @map("creator_id")
  creator   Creator  @relation(fields: [creatorId], references: [id])
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sound_boards")
}
