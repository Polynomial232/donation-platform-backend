// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DonationStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED

  @@map("donation_status")
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  REFUNDED

  @@map("transaction_status")
}

enum OverlayType {
  ALERT
  GOAL
  EVENT_LIST

  @@map("overlay_type")
}

enum QueueStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@map("queue_status")
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  username    String    @unique
  password    String
  displayName String?   @map("display_name")
  avatarUrl   String?   @map("avatar_url")
  
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  
  // Relations
  profile     Profile?
  creator     Creator?
  donations   Donation[] @relation("DonorRelation")
  follows     Follow[]
  overlays    Overlay[]
  goals       Goal[]

  @@map("users")
}

model Profile {
  id                   String   @id @default(cuid())
  userId               String   @unique @map("user_id")
  user                 User     @relation(fields: [userId], references: [id])
  bio                  String?
  xenditApiKey         String?  @map("xendit_api_key")
  notificationSettings Json?    @map("notification_settings")
  socialLinks          Json?    @map("social_links")

  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  @@map("profiles")
}

model Creator {
  id                String    @id @default(cuid())
  userId            String    @unique @map("user_id")
  user              User      @relation(fields: [userId], references: [id])
  username          String    @unique
  displayName       String    @map("display_name")
  avatarUrl         String?   @map("avatar_url")
  bannerUrl         String?   @map("banner_url")
  bio               String?
  isVerified        Boolean   @default(false) @map("is_verified")
  isLive            Boolean   @default(false) @map("is_live")
  
  categories        Category[]
  followers         Follow[]
  receivedDonations Donation[] @relation("RecipientRelation")
  sections          CreatorSection[]
  
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  @@map("creators")
}

model CreatorSection {
  id         String   @id @default(cuid())
  creatorId  String   @map("creator_id")
  creator    Creator  @relation(fields: [creatorId], references: [id])
  type       String
  title      String
  isEnabled  Boolean  @default(true) @map("is_enabled")
  data       Json
  rowOrder   Int      @default(0) @map("row_order")
  
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("creator_sections")
}

model Category {
  id         String    @id @default(cuid())
  name       String    @unique
  creators   Creator[]
  
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("categories")
}

model Follow {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  creatorId  String   @map("creator_id")
  creator    Creator  @relation(fields: [creatorId], references: [id])
  
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, creatorId])
  @@map("follows")
}

model Donation {
  id            String         @id @default(cuid())
  externalId    String         @unique @map("external_id")
  amount        Decimal        @db.Decimal(12, 2)
  currency      String         @default("IDR")
  donorName     String         @map("donor_name")
  message       String?
  status        DonationStatus @default(PENDING)
  paymentUrl    String?        @map("payment_url")
  paymentMethod String?        @map("payment_method")
  
  recipientId   String         @map("recipient_id")
  recipient     Creator        @relation("RecipientRelation", fields: [recipientId], references: [id])
  
  donorId       String?        @map("donor_id")
  donor         User?          @relation("DonorRelation", fields: [donorId], references: [id])
  
  mediaType     String?        @map("media_type")
  mediaUrl      String?        @map("media_url")
  
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")

  transactions  Transaction[]

  @@map("donations")
}

model Transaction {
  id          String            @id @default(cuid())
  donationId  String            @map("donation_id")
  donation    Donation          @relation(fields: [donationId], references: [id])
  amount      Decimal           @db.Decimal(12, 2)
  currency    String            @default("IDR")
  status      TransactionStatus @default(PENDING)
  referenceId String?           @unique @map("reference_id")
  
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  deletedAt   DateTime?         @map("deleted_at")

  @@map("transactions")
}

model Overlay {
  id        String      @id @default(cuid())
  userId    String      @map("user_id")
  user      User        @relation(fields: [userId], references: [id])
  type      OverlayType
  name      String
  config    Json
  token     String      @unique
  isActive  Boolean     @default(true) @map("is_active")
  
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  deletedAt DateTime?   @map("deleted_at")

  @@map("overlays")
}

model Goal {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id])
  title         String
  targetAmount  Decimal   @db.Decimal(12, 2) @map("target_amount")
  currentAmount Decimal   @db.Decimal(12, 2) @default(0) @map("current_amount")
  startDate     DateTime  @default(now()) @map("start_date")
  endDate       DateTime? @map("end_date")
  isActive      Boolean   @default(true) @map("is_active")
  
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  @@map("goals")
}

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model ApiQueue {
  id         String      @id @default(cuid())
  url        String
  method     String      @default("POST")
  headers    Json?
  body       Json?
  status     QueueStatus @default(PENDING)
  type       String
  retryCount Int         @default(0) @map("retry_count")
  maxRetries Int         @default(3) @map("max_retries")
  lastError  String?     @map("last_error")
  
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  deletedAt  DateTime?   @map("deleted_at")

  @@map("api_queues")
}

model ApiCallback {
  id         String    @id @default(cuid())
  source     String
  eventType  String    @map("event_type")
  payload    Json
  headers    Json?
  statusCode Int?      @map("status_code")
  
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@map("api_callbacks")
}

